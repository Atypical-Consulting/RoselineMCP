<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Token-savings benchmark harness. Runs the real navigation/edit services against RoselineMCP's
    own source (dogfooding) and measures the token cost of each tool's output versus the source an
    agent would otherwise read. Deliberately NOT part of RoselineMCP.sln so it doesn't affect the
    server build or the file sweeps. Reproduce with a plain `dotnet run` of this project.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- MSBuildLocator must resolve the SDK's MSBuild at runtime; keep our own MSBuild refs out of the way. -->
    <MSBuildLocatorAtRuntime>true</MSBuildLocatorAtRuntime>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RoselineMCP/RoselineMCP.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <!-- Security override: Microsoft.ML.Tokenizers 2.0.0 pulls in Microsoft.Bcl.Memory 9.0.4
         transitively, which is vulnerable to CVE-2026-26127 (GHSA-73j8-2gch-69rq, high severity:
         Base64Url out-of-bounds-read DoS; fixed in 9.0.14 / 10.0.4). Pin a patched version
         directly (10.0.9, aligned with this project's net10.0 TFM) to override the transitive one.
         Remove once Microsoft.ML.Tokenizers references a fixed build. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.9" />
  </ItemGroup>

</Project>
