---
import Base from '../layouts/Base.astro';
import SavingsChart from '../components/SavingsChart.astro';
import data from '../data/benchmark-results.json';

const base = import.meta.env.BASE_URL;
const m = data.metadata;
const hd = data.headline;
const fmt = (n: number) => n.toLocaleString('en-US');
const pct = (v: number | null) => (v === null ? '—' : `${v >= 0 ? '' : '−'}${Math.round(Math.abs(v) * 100)}%`);
const saved = hd.totalBaselineTokens - hd.totalToolTokens;

const label: Record<string, string> = {
  outline: 'File outline', 'symbol-info': 'Symbol info (metadata)',
  'symbol-info-source': 'Symbol info (+source)', references: 'Find references',
  implementations: 'Find implementations', 'call-graph': 'Call graph (callers)',
  'edit-output': 'Rename → diff',
};
const chartIds = ['outline', 'symbol-info', 'symbol-info-source', 'references', 'implementations', 'call-graph'];
const chartRows = data.suites.filter((s) => chartIds.includes(s.id)).map((s) => ({
  id: s.id, tool: s.tool, title: label[s.id] ?? s.title,
  value: s.aggregate.medianSavingsVsWholeFile, min: s.aggregate.minSavingsVsWholeFile,
  max: s.aggregate.maxSavingsVsWholeFile, pooled: s.aggregate.pooledSavingsVsWholeFile, n: s.aggregate.count,
}));
const editSuite = data.suites.find((s) => s.id === 'edit-output');
const reproduce = 'git clone https://github.com/Atypical-Consulting/RoselineMCP\ncd RoselineMCP\ndotnet run --project RoselineMCP.TokenBenchmark -c Release';
---
<Base title="Benchmark — how many tokens RoselineMCP saves" active="benchmark"
      description="An honest, reproducible measurement of the token savings from RoselineMCP's navigation tools, run against its own source.">
  <section>
    <div class="wrap">
      <span class="eyebrow">Measured · reproducible</span>
      <h1 style="margin:1rem 0">How many tokens does it save?</h1>
      <p class="lede">Every figure is a real string — the tool's actual JSON output versus the source
        an agent would otherwise read, tokenized with a real BPE tokenizer. The suites are
        <strong>systematic sweeps</strong> over RoselineMCP's own source, so the distribution is
        representative. Weak cases included.</p>

      <div class="bstats">
        <div class="bstat"><div class="bn save-big">{Math.round(hd.medianSavingsReadTools * 100)}%</div><div class="bl">median per task</div></div>
        <div class="bstat"><div class="bn">{Math.round(hd.pooledSavingsReadTools * 100)}%</div><div class="bl">pooled reduction · size-weighted</div></div>
        <div class="bstat"><div class="bn">{fmt(saved)}</div><div class="bl">tokens saved on the sample</div></div>
        <div class="bstat"><div class="bn">{fmt(hd.totalBaselineTokens)}</div><div class="bl">baseline · reading the files</div></div>
      </div>
      <div class="meta">
        <span><b>Target</b> {m.solution} · {m.targetProject}</span>
        <span><b>Files</b> {m.filesSwept}</span>
        <span><b>Symbols</b> {m.symbolsSwept}</span>
        <span><b>Tokenizer</b> cl100k_base</span>
        <span><b>Commit</b> <code>{m.commit}</code></span>
        <span><b>Date</b> {m.generatedAt}</span>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow">Savings by tool</span><h2>What each tool returns vs. reading the file</h2></div>
      <SavingsChart rows={chartRows} />

      <div class="note" style="margin-top:1.6rem">
        <h3>Where the file outline wins — and where it can't</h3>
        <p>The first run of this benchmark caught <code>search_symbols</code> outline <em>costing</em>
          tokens: it repeated the file path and fully-qualified name on every symbol. That was fixed —
          the outline now returns a lean projection, and the median went from <span class="cost-ink">−45%</span>
          to <span class="save-ink">+30%</span>.</p>
        <p style="margin-bottom:0">What remains is a limit, not a bug. Outline wins big on body-heavy
          files (<code>Program.cs</code> <span class="save-ink">+89%</span>, <code>CodeFixService.cs</code>
          <span class="save-ink">+76%</span>) but only breaks even on declaration-only files
          (<code>IDiagnosticFilterService.cs</code> <span class="cost-ink">−92%</span>) — an interface
          <em>is</em> already just signatures. Read those directly; outline the big ones.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Full results</span>
        <h2>Two baselines, honestly</h2>
        <p><strong>B1 (whole-file)</strong> = the file(s) an agent must open — realistic but generous.
          <strong>B2 (targeted)</strong> = only the relevant lines ±3 (a <code>grep -C3</code> model) —
          a conservative floor. “Weak” = tasks that saved under 25% vs B1.</p>
      </div>
      <div class="tablewrap">
        <table>
          <thead><tr>
            <th>Tool</th><th>Scenario</th><th class="num">n</th><th class="num">median</th>
            <th class="num">pooled</th><th class="num">range</th><th class="num">vs grep</th><th class="num">weak</th>
          </tr></thead>
          <tbody>
            {data.suites.map((s) => {
              const a = s.aggregate;
              return (
                <tr>
                  <td class="tmono">{s.tool}</td>
                  <td>{s.title}{!s.systematic && <span class="pill" style="margin-left:.4rem">illustrative</span>}</td>
                  <td class="num">{a.count}</td>
                  <td class={`num ${a.medianSavingsVsWholeFile >= 0.25 ? 'save-ink' : 'cost-ink'}`}>{pct(a.medianSavingsVsWholeFile)}</td>
                  <td class={`num ${a.pooledSavingsVsWholeFile >= 0.25 ? 'save-ink' : 'cost-ink'}`}>{pct(a.pooledSavingsVsWholeFile)}</td>
                  <td class="num muted">{pct(a.minSavingsVsWholeFile)}…{pct(a.maxSavingsVsWholeFile)}</td>
                  <td class="num muted">{pct(a.medianSavingsVsTargeted)}</td>
                  <td class="num muted">{a.weakOrNegativeCount}/{a.count}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div class="note" style="margin-top:1.6rem">
        <h3>Reading the two baselines</h3>
        <ul class="clean">
          <li><strong>vs. whole files (B1):</strong> the read tools cut 54–91% — a file is far bigger than the one fact you needed from it.</li>
          <li><strong>vs. an optimal grep (B2):</strong> the tools are roughly comparable in raw tokens (<code>find_references</code> ≈ <code>grep -C3</code>). Their edge over grep is <em>structure and precision</em> — resolved symbols, cross-project references, real call edges — not raw count.</li>
          <li><strong><code>get_symbol_info</code> with <code>includeSource=true</code></strong> (~55%) is shown separately: you get the body back, so it doesn't pretend to replace reading code you're about to edit.</li>
        </ul>
      </div>

      {editSuite && (
        <div class="note" style="margin-top:1.1rem">
          <h3>Output tokens: a diff, not a rewrite</h3>
          <p style="margin-bottom:0">A different axis — the tokens an agent must <em>emit</em>.
            <code>rename_symbol</code> returns a unified diff instead of the full text of every file it
            touches: a pooled <span class="save-ink">{pct(editSuite.aggregate.pooledSavingsVsWholeFile)}</span>
            reduction across {editSuite.aggregate.count} illustrative renames.</p>
        </div>
      )}
    </div>
  </section>

  <section>
    <div class="wrap two-col">
      <div>
        <div class="sec-head"><span class="eyebrow">Methodology</span></div>
        <ul class="clean">{data.methodology.map((x: string) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <div class="sec-head"><span class="eyebrow">Limitations</span></div>
        <ul class="clean">{data.limitations.map((x: string) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow">Reproduce it</span><h2>Run it on your own solution</h2>
        <p>The harness loads the solution once via MSBuild, runs the real services, tokenizes their output, and writes the JSON this page renders.</p></div>
      <div class="codeblock" id="repro" style="max-width:640px">
        <div class="cb-head"><span>shell</span></div>
        <button class="copy" data-copy-target="#repro pre"><span class="copy-label">Copy</span></button>
        <pre><code>{reproduce}</code></pre>
      </div>
      <p class="muted" style="font-size:.86rem;margin-top:1rem">Output: <code>website/src/data/benchmark-results.json</code>, stamped with the commit and date. Tokenizer: {m.tokenizer}.</p>
    </div>
  </section>

  <style>
    .bstats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line);
      border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; box-shadow: var(--shadow); margin: 1.8rem 0 1rem; }
    .bstat { background: var(--surface); padding: 1.25rem; }
    .bn { font-family: var(--display); font-size: clamp(1.7rem, 3.4vw, 2.4rem); font-weight: 640; letter-spacing: -0.03em; line-height: 1; color: var(--ink); }
    .bn.save-big { color: var(--teal-ink); }
    .bl { margin-top: .5rem; font-size: .8rem; color: var(--muted); }
    .meta { display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; font-size: .84rem; color: var(--muted); }
    .meta b { color: var(--ink-2); font-weight: 600; font-family: var(--mono); font-size: .74rem; text-transform: uppercase; letter-spacing: .05em; margin-right: .35rem; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2.6rem; }
    @media (max-width: 820px) { .bstats { grid-template-columns: 1fr 1fr; } .two-col { grid-template-columns: 1fr; gap: 1.5rem; } }
    @media (max-width: 460px) { .bstats { grid-template-columns: 1fr; } }
  </style>
</Base>
