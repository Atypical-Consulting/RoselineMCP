---
import Base from '../layouts/Base.astro';
import { tools, groups, toolCountPhrase, codeIntelligenceToolPhrase } from '../data/tools.ts';
import data from '../data/benchmark-results.json';

const base = import.meta.env.BASE_URL;
const h = data.headline;
const pooled = Math.round(h.pooledSavingsReadTools * 100);
const median = Math.round(h.medianSavingsReadTools * 100);
const saved = h.totalBaselineTokens - h.totalToolTokens;
const fmt = (n: number) => n.toLocaleString('en-US');
const headlineIds = new Set(['outline', 'symbol-info', 'references', 'implementations', 'call-graph']);
const tasks = data.suites.filter((s) => headlineIds.has(s.id)).reduce((n, s) => n + s.aggregate.count, 0);

const dnx = `{
  "mcpServers": {
    "roseline": {
      "command": "dnx",
      "args": ["RoselineMCP", "--yes"]
    }
  }
}`;
const guardHook = `{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "roseline-mcp guard", "timeout": 30 }
        ]
      }
    ]
  }
}`;
const groupBlurb: Record<string, string> = {
  'Code navigation': 'Read-only. Retrieve structure instead of source.',
  'Code editing': 'Write a member-level diff, not a whole-file rewrite. Preview by default.',
  'Diagnostics & fixes': 'Analyze and auto-fix — the original surface.',
};
---
<Base title="RoselineMCP — Roslyn code intelligence for AI agents" active="home">
  <!-- ─────────────── HERO ─────────────── -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Roslyn code intelligence · MCP</span>
        <h1>Your agent reads<br />the whole file.<br /><span class="hl">RoselineMCP reads the code.</span></h1>
        <p class="lede">
          A .NET server that gives Claude, Cursor, and Copilot a Roslyn view of your C# solution —
          symbols, references, call graphs, surgical edits. Agents navigate by structure instead of
          re-reading source. Measured <strong>{median}% fewer tokens</strong> (median) on real code.
        </p>
        <div class="hero-actions">
          <a class="btn primary" href="#install">Install RoselineMCP</a>
          <a class="btn ghost" href={base + 'benchmark'}>See the benchmark →</a>
        </div>
      </div>

      <aside class="hero-side">
        <div class="hero-install codeblock" id="hero-mcp">
          <div class="cb-head"><span>claude · vs&nbsp;code · cursor</span></div>
          <button class="copy" data-copy-target="#hero-mcp pre" aria-label="Copy config"><span class="copy-label">Copy</span></button>
          <pre><code>{dnx}</code></pre>
        </div>
        <p class="hero-side-note mono">runs on demand · needs the .NET&nbsp;10 SDK</p>
      </aside>
    </div>
  </section>

  <!-- ─────────────── SHOWCASE: the rose-line transform ─────────────── -->
  <section class="showcase">
    <div class="wrap">
      <div class="showcase-head">
        <span class="eyebrow">The idea</span>
        <p>One <code>search_symbols</code> call returns the <em>shape</em> of a file. Real numbers from
          this repo: <strong>2,093 tokens become 120</strong> — the agent gets what it needs, you skip the wall.</p>
      </div>

      <figure class="transform" aria-label="RoselineMCP turns a 2,093-token file into a 120-token outline.">
        <div class="tpanel file">
          <div class="tp-head"><span class="mono">Program.cs · the whole file</span><span class="tp-cost mono">2,093 tokens</span></div>
          <pre class="mono">{`var host = CreateHostBuilder(args).Build();
var logger = host.Services
    .GetRequiredService<ILogger<Program>>();
logger.LogInformation("starting…");

static IHostBuilder CreateHostBuilder(string[] a) =>
  Host.CreateDefaultBuilder(a)
    .ConfigureServices((ctx, services) =>
    {
      services.AddMcpServer()
        .WithStdioServerTransport()
        .WithToolsFromAssembly();
      services.AddSingleton<IMSBuildService, …>();
      services.AddSingleton<IDiffService, …>();
      services.AddSingleton<IProjectLoader, …>();
      // …10 more registrations…
    })
    .ConfigureLogging(…);`}</pre>
        </div>

        <div class="roseline" aria-hidden="true">
          <span class="rl-node mono">search_symbols</span>
          <span class="rl-arrow mono">→</span>
        </div>

        <div class="tpanel struct">
          <div class="tp-head"><span class="mono">the outline it returns</span>
            <span class="tp-save mono">120&nbsp;tokens</span><span class="pill write">−94%</span></div>
          <div class="outrows">
            <div class="orow"><span class="okind">class</span><span class="osig mono">Program</span></div>
            <div class="orow"><span class="okind">method</span><span class="osig mono">CreateHostBuilder(string[]) : IHostBuilder</span><span class="oline mono">:53</span></div>
            <div class="orow"><span class="okind">ctor</span><span class="osig mono">Program()</span><span class="oline mono">:125</span></div>
          </div>
          <p class="tp-note">Signatures and locations — no method bodies, no using directives, no wall.</p>
        </div>
      </figure>
    </div>
  </section>

  <!-- ─────────────── PROOF ─────────────── -->
  <section class="proof">
    <div class="wrap">
      <div class="proof-grid">
        <div class="proof-lead">
          <span class="eyebrow">Measured, not marketed</span>
          <h2>{median}% fewer tokens, on its own source.</h2>
          <p>Every figure is a real string — the tool's actual output vs. the source an agent would
            otherwise read, tokenized with a real BPE tokenizer, swept systematically over
            {fmt(data.metadata.symbolsSwept)} symbols. Weak cases shown, not hidden.</p>
          <a class="btn ghost" href={base + 'benchmark'}>Read the methodology →</a>
        </div>
        <div class="proof-stats">
          <div class="pstat"><div class="pn save-big">{median}%</div><div class="pl">median per task</div></div>
          <div class="pstat"><div class="pn">{pooled}%</div><div class="pl">pooled · size-weighted</div></div>
          <div class="pstat"><div class="pn">{fmt(saved)}</div><div class="pl">tokens saved on the sample</div></div>
          <div class="pstat"><div class="pn">{fmt(tasks)}</div><div class="pl">navigation tasks</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────── POWERED BY ROSLYN ─────────────── -->
  <section class="roslyn">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Powered by Roslyn</span>
        <h2>Not a parser. The compiler.</h2>
        <p>RoselineMCP is built on <a href="https://github.com/dotnet/roslyn">Roslyn</a>, the .NET
          Compiler Platform — the same engine that compiles your code in Visual Studio, <code>csc</code>,
          and the .NET SDK. Every answer it gives is the compiler's answer, not a guess. That's the
          difference between code intelligence you can act on and a fancy text search.</p>
      </div>

      <div class="roslyn-grid">
        <div class="ladder" role="img" aria-label="grep sees text; tree-sitter sees structure; Roslyn sees your program.">
          <div class="rung"><span class="rung-tool mono">grep</span><span class="rung-what">sees text</span></div>
          <div class="rung"><span class="rung-tool mono">tree-sitter</span><span class="rung-what">sees structure</span></div>
          <div class="rung hl"><span class="rung-tool mono">Roslyn</span><span class="rung-what">sees your <em>program</em></span></div>
        </div>

        <div class="why">
          <div class="whyitem">
            <h3>Semantic, not textual</h3>
            <p>It resolves symbols, types, overloads, and generics across the whole solution — it knows the <code>Add</code> here is the <em>same</em> method as the call over there. Meaning, not string matches.</p>
          </div>
          <div class="whyitem">
            <h3>Compiler-grade accuracy</h3>
            <p><code>find_references</code> is exact. <code>rename_symbol</code> updates real references, not text. Call graphs follow real bindings — which is why the edits are safe and the navigation is precise.</p>
          </div>
          <div class="whyitem">
            <h3>The whole solution, loaded</h3>
            <p>MSBuildWorkspace loads your real project graph, references, and analyzers. RoselineMCP sees your code exactly the way it compiles — not a fuzzy approximation of it.</p>
          </div>
          <div class="whyitem">
            <h3>First-party &amp; open source</h3>
            <p>Roslyn is Microsoft's, powers every serious C# tool, and is <a href="https://github.com/dotnet/roslyn">open on GitHub</a>. RoselineMCP is a thin, honest layer on a foundation you already trust.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────── INSTALL ─────────────── -->
  <section id="install" class="install">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Install</span>
        <h2>One line. Any MCP client.</h2>
        <p>RoselineMCP runs as a local stdio process your MCP client launches. Pick how you want it on
          disk — the tools are identical.</p>
      </div>

      <div class="itabs" data-install-tabs>
        <div class="itablist" role="tablist" aria-label="Install method">
          <button class="itab" role="tab" id="tab-dnx" aria-controls="p-dnx" aria-selected="true">dnx <span class="tab-tag">recommended</span></button>
          <button class="itab" role="tab" id="tab-mcpb" aria-controls="p-mcpb" aria-selected="false">Claude Desktop <span class="tab-tag">1-click</span></button>
          <button class="itab" role="tab" id="tab-nuget" aria-controls="p-nuget" aria-selected="false">NuGet tool</button>
          <button class="itab" role="tab" id="tab-docker" aria-controls="p-docker" aria-selected="false">Docker</button>
        </div>

        <div class="ipanel" id="p-dnx" role="tabpanel" aria-labelledby="tab-dnx">
          <p>Any client that speaks <code>dnx</code> (the .NET <code>npx</code>) runs it on demand — no install step. Needs the .NET&nbsp;10 SDK. Add to your MCP config:</p>
          <div class="codeblock" id="inst-dnx">
            <div class="cb-head"><span>mcp.json / claude_desktop_config.json</span></div>
            <button class="copy" data-copy-target="#inst-dnx pre"><span class="copy-label">Copy</span></button>
            <pre><code>{dnx}</code></pre>
          </div>
        </div>

        <div class="ipanel" id="p-mcpb" role="tabpanel" aria-labelledby="tab-mcpb" hidden>
          <p>Download the bundle and open it — Claude&nbsp;Desktop shows an install dialog, no JSON to edit.
            It launches via <code>dnx</code> under the hood, so the .NET&nbsp;10 SDK is still required.</p>
          <p><a class="btn primary" href={base + 'releases'}>Get <code>RoselineMCP.mcpb</code> →</a></p>
          <p class="muted small">Attached to every <a href={base + 'releases'}>release</a>.</p>
        </div>

        <div class="ipanel" id="p-nuget" role="tabpanel" aria-labelledby="tab-nuget" hidden>
          <p>Installs the <code>roseline-mcp</code> command globally — offline, pinned to a version.</p>
          <div class="codeblock" id="inst-nuget">
            <div class="cb-head"><span>shell</span></div>
            <button class="copy" data-copy-target="#inst-nuget pre"><span class="copy-label">Copy</span></button>
            <pre><code>dotnet tool install -g RoselineMCP</code></pre>
          </div>
          <p class="muted small">Then set <code>"command": "roseline-mcp"</code> in your MCP config.</p>
        </div>

        <div class="ipanel" id="p-docker" role="tabpanel" aria-labelledby="tab-docker" hidden>
          <p>Runs anywhere Docker does — no .NET install on the host.</p>
          <div class="codeblock" id="inst-docker">
            <div class="cb-head"><span>shell</span></div>
            <button class="copy" data-copy-target="#inst-docker pre"><span class="copy-label">Copy</span></button>
            <pre><code>docker run -i --rm phmatray/roseline-mcp:latest</code></pre>
          </div>
          <p class="muted small">The <code>-i</code> flag is required for stdio transport.</p>
        </div>
      </div>
      <p class="clients muted">
        Verified with <strong>Claude Desktop</strong>, <strong>VS&nbsp;Code</strong> (Copilot / MCP),
        and <strong>Cursor</strong>. Per-client config in the
        <a href="https://github.com/Atypical-Consulting/RoselineMCP#mcp-client-compatibility">README</a>.
        Also listed in the <a href="https://registry.modelcontextprotocol.io">official MCP Registry</a>,
        so registry-aware clients can find it by name.
      </p>
    </div>
  </section>

  <!-- ─────────────── COMPILE GUARD ─────────────── -->
  <section id="guard" class="guard">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Compile guard <span class="tab-tag">opt-in</span></span>
        <h2>The compiler’s opinion, after every write.</h2>
        <p>RoselineMCP’s write tools already refuse an edit that breaks the build. But an agent that
          reaches for plain <code>Edit</code> never gets that verdict. The guard runs as a
          <code>PostToolUse</code> hook, so the compiler judges every write — whichever tool made it.</p>
      </div>

      <div class="codeblock" id="guard-hook">
        <div class="cb-head"><span>.claude/settings.json — or run <code>roseline-mcp guard --print-hook</code></span></div>
        <button class="copy" data-copy-target="#guard-hook pre"><span class="copy-label">Copy</span></button>
        <pre><code>{guardHook}</code></pre>
      </div>

      <ul class="glist">
        <li><strong>Silence is the normal outcome.</strong> Nothing broke, nothing is said — no output,
          no tokens.</li>
        <li><strong>It never blames the branch you landed on.</strong> Only errors <em>this</em> edit
          introduced are reported; pre-existing ones stay the branch’s problem.</li>
        <li><strong>It reports; it cannot block.</strong> <code>PostToolUse</code> fires after the write
          and carries no blocking decision — what it changes is that the agent finds out in the same
          turn instead of three turns later.</li>
        <li><strong>It fails quiet.</strong> Server off, slow, or the file isn’t C#? Exit 0, silent. A
          guard that can’t inform must not be able to interrupt.</li>
      </ul>

      <p class="muted small">Off by default — set <code>ROSELINE_RoselineMCP__Guard=true</code>. It opens
        a local, per-user socket; read
        <a href="https://github.com/Atypical-Consulting/RoselineMCP/blob/dev/SECURITY.md#known-risk-the-compile-guard-endpoint">SECURITY.md</a>
        before enabling it on a shared machine.</p>
    </div>
  </section>

  <!-- ─────────────── TOOLS ─────────────── -->
  <section class="tools">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">The surface</span>
        <h2>{toolCountPhrase}. Structure in, tokens down.</h2>
        <p>{codeIntelligenceToolPhrase} on top of the original diagnostics surface.
          <a href={base + 'tools'}>Full reference →</a></p>
      </div>
      {groups.map((g) => (
        <div class="tgroup">
          <div class="tg-head"><h3>{g}</h3><span class="tg-blurb">{groupBlurb[g]}</span></div>
          <div class="tgrid">
            {tools.filter((t) => t.group === g).map((t) => (
              <div class="tcard">
                <div class="tc-top"><code>{t.name}</code>
                  <span class={`pill ${t.kind === 'write' ? 'write' : 'read'}`}>{t.kind === 'write' ? 'write' : 'read'}</span></div>
                <p>{t.summary}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <style>
    /* COMPILE GUARD */
    .guard { background: var(--surface); }
    .guard .codeblock { max-width: 62ch; }
    .glist { list-style: none; padding: 0; margin: 1.6rem 0 1rem; display: grid; gap: .75rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 26ch), 1fr)); }
    .glist li { padding: .8rem 1rem; border-radius: 11px; background: var(--bg); border: 1px solid var(--line);
      font-size: .88rem; color: var(--ink-2); line-height: 1.55; }
    .glist strong { color: var(--ink); }

    /* HERO */
    .hero { padding-top: 3.4rem; padding-bottom: 3.4rem; }
    .hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 3rem; align-items: center; }
    .hero-copy h1 { margin: 1.1rem 0 1.2rem; }
    .hero-copy h1 .hl { color: var(--rose); }
    .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.7rem; }
    .hero-side { align-self: center; }
    .hero-install { box-shadow: var(--shadow); }
    .hero-install .cb-head span { text-transform: uppercase; letter-spacing: .1em; }
    .hero-side-note { margin: .7rem .2rem 0; font-size: .72rem; color: var(--muted); text-align: right; }

    /* SHOWCASE / TRANSFORM SIGNATURE */
    .showcase { background: var(--surface); }
    .showcase-head { margin-bottom: 1.6rem; }
    .showcase-head p { font-size: 1.08rem; margin: .55rem 0 0; max-width: 66ch; color: var(--ink-2); }
    .transform { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr) 132px minmax(0, 1fr); align-items: stretch; }
    .tpanel { border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
    .tpanel.file { background: var(--code-bg); border: 1px solid var(--code-line); box-shadow: var(--shadow); }
    .tpanel.struct { background: var(--inset); border: 1px solid var(--line); box-shadow: var(--shadow); }
    .tp-head { display: flex; align-items: center; gap: .5rem; padding: .6rem .9rem; font-size: .72rem; letter-spacing: .03em; flex: none; }
    .tpanel.file .tp-head { color: var(--code-dim); border-bottom: 1px solid var(--code-line); }
    .tpanel.struct .tp-head { color: var(--muted); border-bottom: 1px solid var(--line); }
    .tp-cost { margin-left: auto; color: #ff9bb6; }
    .tp-save { margin-left: auto; color: var(--teal-ink); }
    .tpanel.file pre { flex: 1; margin: 0; padding: .85rem 1rem; font-size: .72rem; line-height: 1.62; color: var(--code-dim);
      overflow: hidden; white-space: pre; -webkit-mask-image: linear-gradient(180deg, #000 82%, transparent); mask-image: linear-gradient(180deg, #000 82%, transparent); }
    .outrows { padding: .8rem .7rem; display: flex; flex-direction: column; gap: .4rem; }
    .orow { display: flex; align-items: baseline; gap: .55rem; padding: .42rem .6rem; border-radius: 9px; background: var(--surface); border: 1px solid var(--line); }
    .okind { font-family: var(--mono); font-size: .64rem; text-transform: uppercase; letter-spacing: .05em; color: var(--teal-ink); background: var(--teal-soft); border-radius: 5px; padding: .12rem .4rem; flex: none; }
    .osig { font-size: .8rem; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .oline { margin-left: auto; color: var(--muted); font-size: .72rem; flex: none; }
    .tp-note { padding: .1rem .9rem 1rem; margin: auto 0 0; font-size: .78rem; color: var(--muted); }

    .roseline { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .5rem; }
    .roseline::before { content: ""; position: absolute; top: 12%; bottom: 12%; left: 50%; width: 2px; transform: translateX(-50%);
      background: linear-gradient(var(--rose), var(--rose)); opacity: .5; }
    .rl-node { position: relative; z-index: 1; font-size: .68rem; color: #fff; background: var(--rose);
      border-radius: 999px; padding: .34rem .62rem; white-space: nowrap; box-shadow: 0 0 0 6px var(--rose-soft); }
    .rl-arrow { position: relative; z-index: 1; color: var(--rose); font-size: 1.1rem; line-height: 1; }

    /* PROOF */
    .proof-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.6rem; align-items: center; }
    .proof-lead h2 { margin: .9rem 0 .7rem; }
    .proof-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; box-shadow: var(--shadow); }
    .pstat { background: var(--surface); padding: 1.35rem 1.3rem; }
    .pstat .pn { font-family: var(--display); font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 640; letter-spacing: -0.03em; color: var(--ink); line-height: 1; }
    .pstat .pn.save-big { color: var(--teal-ink); }
    .pstat .pl { margin-top: .5rem; font-size: .82rem; color: var(--muted); }

    /* POWERED BY ROSLYN */
    .roslyn { background: var(--surface); }
    .roslyn-grid { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: 2.8rem; align-items: start; margin-top: .5rem; }
    .ladder { position: relative; display: flex; flex-direction: column; gap: 1.7rem; padding-left: 1.5rem; }
    .ladder::before { content: ""; position: absolute; left: 5px; top: 10px; bottom: 10px; width: 2px; border-radius: 2px; background: linear-gradient(var(--line), var(--rose)); }
    .rung { position: relative; }
    .rung::before { content: ""; position: absolute; left: calc(-1.5rem + 1px); top: 5px; width: 10px; height: 10px; border-radius: 50%; background: var(--surface); border: 2px solid var(--line); }
    .rung.hl::before { background: var(--rose); border-color: var(--rose); box-shadow: 0 0 0 5px var(--rose-soft); }
    .rung-tool { display: block; font-size: 1rem; color: var(--ink-2); line-height: 1.2; }
    .rung-what { color: var(--muted); font-size: .9rem; }
    .rung.hl .rung-tool { font-size: 1.5rem; color: var(--rose); font-weight: 500; letter-spacing: -.01em; }
    .rung.hl .rung-what { color: var(--ink); font-size: 1.05rem; }
    .rung.hl .rung-what em { color: var(--rose); font-style: normal; font-weight: 600; }
    .why { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem 1.9rem; }
    .whyitem h3 { margin: 0 0 .35rem; font-size: 1.05rem; }
    .whyitem p { margin: 0; font-size: .92rem; }
    @media (max-width: 900px) { .roslyn-grid { grid-template-columns: 1fr; gap: 2rem; } .why { grid-template-columns: 1fr; } }

    /* INSTALL — tabs */
    .itabs { max-width: 760px; }
    .itablist { display: inline-flex; flex-wrap: wrap; gap: .25rem; padding: .3rem; background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; margin-bottom: 1.2rem; }
    .itab { font-family: var(--mono); font-size: .88rem; color: var(--ink-2); background: transparent; border: 1px solid transparent; border-radius: 9px; padding: .5rem .9rem; cursor: pointer; display: inline-flex; align-items: center; gap: .5rem; transition: color .12s ease; }
    .itab:hover { color: var(--ink); }
    .itab[aria-selected="true"] { background: var(--surface); color: var(--ink); border-color: var(--line); box-shadow: var(--shadow); }
    .tab-tag { font-size: .6rem; text-transform: uppercase; letter-spacing: .04em; color: var(--rose-ink); background: var(--rose-soft); border-radius: 999px; padding: .1rem .42rem; }
    .ipanel[hidden] { display: none; }
    .ipanel p { font-size: .95rem; margin: 0 0 .8rem; max-width: 66ch; }
    .ipanel .codeblock { max-width: 620px; }
    .ipanel p.small { margin-top: .7rem; }
    .small { font-size: .84rem; }
    .clients { margin-top: 1.8rem; font-size: .92rem; }

    /* TOOLS */
    .tgroup { margin-bottom: 1.8rem; }
    .tg-head { display: flex; align-items: baseline; gap: .8rem; flex-wrap: wrap; margin-bottom: .8rem; padding-bottom: .5rem; border-bottom: 1px solid var(--line); }
    .tg-head h3 { margin: 0; }
    .tg-blurb { color: var(--muted); font-size: .86rem; }
