---
import Base from '../layouts/Base.astro';
import {
  tools, groups, toolCount, toolCountPhrase, readToolPhrase, writeToolPhrase,
  analyzerLoadTools, analyzerLoadToolPhrase,
} from '../data/tools.ts';
const base = import.meta.env.BASE_URL;
const kindLabel: Record<string, string> = { read: 'read-only', write: 'write · preview', diagnostics: 'read-only' };
const groupBlurb: Record<string, string> = {
  'Code navigation': 'Return precise structure instead of source — the token-saving surface.',
  'Code editing': 'Emit a member-level diff, never a whole-file rewrite. Preview by default.',
  'Diagnostics & fixes': 'The original surface: analyze a solution and apply automated fixes.',
};
---
<Base title="Tool reference — RoselineMCP" active="tools"
      description={`The ${toolCount} MCP tools RoselineMCP exposes: code navigation, code editing, and diagnostics.`}>
  <section>
    <div class="wrap">
      <span class="eyebrow">Reference</span>
      <h1 style="margin:1rem 0">{toolCountPhrase}</h1>
      <p class="lede">The navigation, editing, and diagnostics/fix tools take an <strong>optional</strong>
        <code>project</code> (name, directory, <code>.csproj</code>, or <code>.sln</code> path) — omit it
        and RoselineMCP auto-discovers the solution/project from its working directory. A
        <code>symbol</code> is a simple or fully-qualified name — add a parameter list to pick an
        overload. Wire names are <code>snake_case</code>. Full request/response shapes live in
        <a href="https://github.com/Atypical-Consulting/RoselineMCP/blob/dev/docs/API.md">docs/API.md</a>.</p>

      <div class="note" style="margin:1.6rem 0">
        <p style="margin:0"><strong>Which checkout answered?</strong> Auto-discovery is anchored to
          <em>the server's</em> working directory — the one your MCP client launched RoselineMCP in —
          not yours. They differ whenever you work in a git worktree (e.g.
          <code>.claude/worktrees/&lt;name&gt;</code>), which sits below the discovery walk's reach, so
          an omitted <code>project</code> resolves the <strong>main checkout</strong> instead. Two
          checkouts of one repo are otherwise indistinguishable in a response, so every tool with an
          optional <code>project</code> returns <code>resolvedPath</code> — the absolute
          <code>.sln</code>/<code>.csproj</code> that actually answered: the <code>.sln</code> when the
          solution was loaded and contains the project, otherwise the <code>.csproj</code> that was
          opened directly (e.g. a project not listed in its nearest ancestor <code>.sln</code>). Pass
          an absolute path as <code>project</code> to target a specific checkout.
          (<code>analyze_solution</code> is the exception — its <code>pathOrGit</code> is required,
          so it auto-discovers nothing.)</p>
      </div>

      <div class="note" style="margin:1.6rem 0">
        <p style="margin:0"><strong>Read-only by default.</strong> The {readToolPhrase} and the
          diagnostics/patch tools never touch disk. The {writeToolPhrase}
          (<code>edit_member</code>, <code>rename_symbol</code>, <code>apply_fixes</code>) default to
          <code>previewOnly: true</code> — they return a diff and write nothing unless you pass
          <code>previewOnly: false</code>, and even then they <strong>ask your client to confirm</strong>
          via MCP elicitation before writing (declining downgrades the call to a preview). So does
          leaving the prompt unanswered: the round-trip is bounded by
          <code>RoselineMCP:ConfirmDestructiveWritesTimeout</code> (default 5 minutes), after which
          the call returns a preview rather than writing or hanging. That
          confirmation can be switched off for unattended hosts with
          <code>RoselineMCP:ConfirmDestructiveWrites=false</code>, leaving
          <code>previewOnly: false</code> as the only guard.</p>
      </div>

      <div class="note" style="margin:1.6rem 0">
        <p style="margin:0"><strong>Degraded coverage is named, never silent.</strong> Roslyn reports
          an analyzer reference it cannot load — one built against a newer
          <code>Microsoft.CodeAnalysis</code> than the server's, the .NET SDK's own analyzers being
          the universal case — by contributing <em>zero</em> analyzers, not by failing. The {analyzerLoadToolPhrase} that report <code>analyzerLoad</code> ({analyzerLoadTools.map((t, i) => <Fragment>{i > 0 && ', '}<code>{t.name}</code></Fragment>)}) therefore return that block naming every
          reference that contributed nothing and why (<code>load-failure</code> with Roslyn's
          <code>errorCode</code> and message, <code>no C# analyzers</code>, or <code>exception</code>).
          It is <strong>omitted when every reference contributed</strong>, so a present block always
          says something — including <code>analyzersRan: false</code> when analyzers are switched
          off. Code fixers are looked up in the Roslyn built-ins, the bundled Roslynator catalog, and
          the project's own analyzer references, in that order.</p>
      </div>

      <div class="envelope">
        <div class="env-head"><h2>Response envelope</h2><span class="v-tag mono">v1.4.0</span></div>
        <p>Every tool returns a typed <code>ToolResult&lt;T&gt;</code>. The <strong>returns</strong> shown
          on each card below is the shape of <code>data</code> — the payload — not the whole envelope.</p>
        <div class="env-shapes">
          <div class="env-row"><span class="pill read">ok</span><code class="mono">{`{ "ok": true, "data": { … } }`}</code></div>
          <div class="env-row"><span class="pill write">err</span><code class="mono">{`{ "ok": false, "error": { "type", "message", "correlationId", "resolvedPath"? } }`}</code></div>
        </div>
        <p class="muted" style="margin-bottom:0">Tools set <code>UseStructuredContent</code>, so
          <code>data</code> is also delivered as MCP <code>structuredContent</code> alongside an advertised
          <code>outputSchema</code>. Long-running tools emit <strong>progress notifications</strong>;
          failures carry a <code>correlationId</code> to the client’s log stream, plus
          <code>resolvedPath</code> — the checkout that answered — whenever the call failed
          <em>after</em> resolving a project. It is omitted entirely when nothing was resolved.</p>
      </div>

      {groups.map((g) => (
        <div class="rgroup">
          <div class="rg-head"><h2>{g}</h2><span class="rg-blurb">{groupBlurb[g]}</span></div>
          <div class="rgrid">
            {tools.filter((t) => t.group === g).map((t) => (
              <div class="rcard" id={t.name}>
                <div class="rc-top">
                  <a class="rc-name mono" href={`#${t.name}`}>{t.name}</a>
                  <span class={`pill ${t.kind === 'write' ? 'write' : 'read'}`}>{kindLabel[t.kind]}</span>
                  {t.progress && <span class="pill cap">progress</span>}
                  {t.verifies && <span class="pill cap" title="Compiles the candidate change in memory before writing and refuses it when it introduces compiler errors — the diff and the errors come back with applied:false. Pass allowIntroducedErrors:true to override.">verifies</span>}
                  {t.confirms && <span class="pill cap" title="Asks your client to confirm via MCP elicitation before writing — unless the operator set RoselineMCP:ConfirmDestructiveWrites=false. A prompt nobody answers expires after 5 minutes into a preview, never a write.">confirms</span>}
                </div>
                <div class="rc-title">{t.title}</div>
                <p class="rc-sum">{t.summary}</p>
                <dl class="rc-io">
                  <dt>params</dt><dd class="mono">{t.params}</dd>
                  <dt>returns</dt><dd class="mono">{t.returns}</dd>
                </dl>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="sec-head" style="margin-top:2.5rem">
        <span class="eyebrow">Proof</span>
        <h2>How much do they save?</h2>
        <p>The read tools exist to spend fewer tokens than reading source. See the
          <a href={base + 'benchmark'}>measured, honest benchmark →</a></p>
      </div>
    </div>
  </section>

  <style>
    /* response-envelope callout */
    .envelope { background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--teal);
      border-radius: 12px; padding: 1.15rem 1.3rem; margin: 1.6rem 0 2.4rem; box-shadow: var(--shadow); }
    .env-head { display: flex; align-items: baseline; gap: .7rem; margin-bottom: .5rem; }
    .env-head h2 { margin: 0; font-size: 1.15rem; }
    .v-tag { font-size: .68rem; color: var(--teal-ink); border: 1px solid color-mix(in srgb, var(--teal) 38%, var(--line));
      background: var(--teal-soft); border-radius: 999px; padding: .1rem .45rem; }
    .env-shapes { display: flex; flex-direction: column; gap: .5rem; margin: .9rem 0; }
    .env-row { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
    .env-row code { background: var(--code-bg); color: var(--code-fg); border: 1px solid var(--code-line);
      border-radius: 7px; padding: .3rem .6rem; font-size: .78rem; overflow-x: auto; }

    .rgroup { margin: 2.2rem 0; }
    .rg-head { display: flex; align-items: baseline; gap: .9rem; flex-wrap: wrap; margin-bottom: 1rem;
      padding-bottom: .6rem; border-bottom: 1px solid var(--line); }
    .rg-head h2 { margin: 0; font-size: 1.35rem; }
    .rg-blurb { color: var(--muted); font-size: .88rem; }
    .rgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; }
    .rcard { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1.15rem; box-shadow: var(--shadow); transition: border-color .12s ease, transform .12s ease; }
    .rcard:hover { border-color: color-mix(in srgb, var(--rose) 26%, var(--line)); transform: translateY(-2px); }
    .rc-top { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-bottom: .3rem; }
    .rc-name { background: none; border: none; padding: 0; color: var(--ink); font-size: 1rem; font-weight: 500; scroll-margin-top: 80px; }
    .rc-name:hover { color: var(--rose-ink); text-decoration: none; }
    .rcard:target { border-color: color-mix(in srgb, var(--rose) 45%, var(--line)); }
    .pill.cap { color: var(--teal-ink); border-color: color-mix(in srgb, var(--teal) 34%, var(--line)); background: var(--teal-soft); }
    .rc-title { font-size: .8rem; color: var(--muted); margin-bottom: .5rem; }
    .rc-sum { margin: 0 0 .8rem; font-size: .92rem; }
    .rc-io { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: .25rem .7rem; align-items: baseline; }
    .rc-io dt { font-family: var(--mono); font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
    .rc-io dd { margin: 0; font-size: .78rem; color: var(--ink-2); line-height: 1.5; }
  </style>
</Base>
