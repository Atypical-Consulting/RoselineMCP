<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet Global Tool Packaging -->
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>roseline-mcp</ToolCommandName>
    <PackageId>RoselineMCP</PackageId>
    <MinVerMinimumMajorMinor>1.1</MinVerMinimumMajorMinor>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Authors>Atypical Consulting SRL</Authors>
    <Description>Roslyn code intelligence for AI coding agents over MCP — token-efficient C# navigation (symbols, references, call graphs, type hierarchies), surgical member-level edits, and diagnostics with automated fixes.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Atypical-Consulting/RoselineMCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Atypical-Consulting/RoselineMCP</RepositoryUrl>
    <PackageTags>mcp;roslyn;csharp;dotnet;code-analysis;ai</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Docker Container Support -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>phmatray/roseline-mcp</ContainerRepository>
    <ContainerFamily>alpine</ContainerFamily>
  </PropertyGroup>

  <!-- RuntimeIdentifiers is intentionally NOT set here. For a PackAsTool project it
       restricts the package to RID-specific assets, breaking `dotnet tool install` on
       other platforms - and that restriction leaks in no matter how the Pack target is
       invoked (`dotnet pack`, `dotnet build -t:pack`, an IDE's Pack command, etc.), so a
       conditional PropertyGroup here can never fully guard against it. Publish steps that
       need a RID pass it on the command line instead: the Docker image (see Dockerfile)
       publishes framework-dependent ReadyToRun with `-r linux-musl-{x64,arm64}` and
       `-p:PublishReadyToRun=true` on the `dotnet publish` invocation only, which never
       leaks into this file or the packed tool. -->

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- MSBuild packages required by Microsoft.Build.Locator -->
    <PackageReference Include="Microsoft.Build" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="4.15.0" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Roslynator.CodeFixes" Version="4.15.0" GeneratePathProperty="true" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="4.15.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.9" />
  </ItemGroup>

  <!-- ═══ Bundled Roslynator analyzer + code fix assemblies ═══
       The Roslynator packages above are analyzer-asset-only (no lib/ folder), so none of their
       assemblies ever land in the build output on their own — Assembly.Load("Roslynator.*")
       can never succeed from this app. To make Roslynator diagnostics and fixes real at
       runtime, the roslyn4.7 analyzer assemblies (the newest variant those packages ship;
       our Microsoft.CodeAnalysis is well above 4.7) are mirrored into an `analyzers/`
       folder next to RoselineMCP.dll, where Services/AnalyzerCatalog discovers them via
       Assembly.LoadFrom. Each package prefixes its internal dependency assemblies with its
       own package name (e.g. Roslynator_CodeFixes_Roslynator.Common.dll — identity matches
       the file name), so one flat folder has no collisions and same-directory dependency
       probing resolves everything. As <None CopyToOutputDirectory> items they also flow to
       referencing projects' output (the test project), to `dotnet publish` output (Docker),
       and are packed into the dotnet tool via the explicit tools/ PackagePath. -->
  <ItemGroup>
    <RoslynatorAnalyzerAsset Include="$(PkgRoslynator_Analyzers)/analyzers/dotnet/roslyn4.7/cs/*.dll" Condition="'$(PkgRoslynator_Analyzers)' != ''" />
    <RoslynatorAnalyzerAsset Include="$(PkgRoslynator_CodeAnalysis_Analyzers)/analyzers/dotnet/roslyn4.7/cs/*.dll" Condition="'$(PkgRoslynator_CodeAnalysis_Analyzers)' != ''" />
    <RoslynatorAnalyzerAsset Include="$(PkgRoslynator_CodeFixes)/analyzers/dotnet/roslyn4.7/cs/*.dll" Condition="'$(PkgRoslynator_CodeFixes)' != ''" />
    <RoslynatorAnalyzerAsset Include="$(PkgRoslynator_Formatting_Analyzers)/analyzers/dotnet/roslyn4.7/cs/*.dll" Condition="'$(PkgRoslynator_Formatting_Analyzers)' != ''" />
    <!-- No explicit Pack/PackagePath needed: PackAsTool packs CopyToOutputDirectory items
         (with their Link-relative path) under tools/$(TargetFramework)/any/ automatically,
         exactly like the packaged appsettings.json. Verified: the nupkg contains all 31
         DLLs at tools/net10.0/any/analyzers/. -->
    <None Include="@(RoslynatorAnalyzerAsset)"
          Link="analyzers/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <!-- The MCP registry manifest MUST ship inside the McpServer package so `dnx`-based clients
         resolve the version declared here. It lives at the repo root (where `mcp-publisher`
         expects it), so include it via a relative path with an explicit PackagePath. Its version
         is stamped from the release tag by publish-nuget.yml, keeping it in lockstep with the
         package version - never hardcode/let it drift (that shipped clients an ancient 1.0.0). -->
    <None Include="../.mcp/server.json" Pack="true" PackagePath=".mcp/server.json" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
