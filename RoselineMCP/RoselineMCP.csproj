<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet Global Tool Packaging -->
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>roseline-mcp</ToolCommandName>
    <PackageId>RoselineMCP</PackageId>
    <MinVerMinimumMajorMinor>1.1</MinVerMinimumMajorMinor>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Authors>Atypical Consulting SRL</Authors>
    <Description>High-performance MCP server for C# code analysis using Roslyn analyzers and code fix providers.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Atypical-Consulting/RoselineMCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Atypical-Consulting/RoselineMCP</RepositoryUrl>
    <PackageTags>mcp;roslyn;csharp;dotnet;code-analysis;ai</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Docker Container Support -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>phmatray/roseline-mcp</ContainerRepository>
    <ContainerFamily>alpine</ContainerFamily>
  </PropertyGroup>

  <!-- RuntimeIdentifiers is intentionally NOT set here. For a PackAsTool project it
       restricts the package to RID-specific assets, breaking `dotnet tool install` on
       other platforms - and that restriction leaks in no matter how the Pack target is
       invoked (`dotnet pack`, `dotnet build -t:pack`, an IDE's Pack command, etc.), so a
       conditional PropertyGroup here can never fully guard against it. The Docker image
       (see Dockerfile) does a plain, portable `dotnet publish` with no `-r`/RuntimeIdentifier,
       so it doesn't need this property either; if a future publish step needs to target
       specific RIDs, pass `-p:RuntimeIdentifiers=linux-x64;linux-arm64` on that invocation's
       command line instead of setting it globally in this file. -->

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- MSBuild packages required by Microsoft.Build.Locator -->
    <PackageReference Include="Microsoft.Build" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0" PrivateAssets="all" />
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="4.15.0" PrivateAssets="all" />
    <PackageReference Include="Roslynator.CodeFixes" Version="4.15.0" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="4.15.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
